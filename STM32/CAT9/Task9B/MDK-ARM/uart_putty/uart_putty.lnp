--cpu Cortex-M3
"uart_putty\startup_stm32f103xb.o"
"uart_putty\main.o"
"uart_putty\stm32f1xx_it.o"
"uart_putty\stm32f1xx_hal_msp.o"
"uart_putty\stm32f1xx_hal_gpio_ex.o"
"uart_putty\stm32f1xx_hal_uart.o"
"uart_putty\stm32f1xx_hal.o"
"uart_putty\stm32f1xx_hal_rcc.o"
"uart_putty\stm32f1xx_hal_rcc_ex.o"
"uart_putty\stm32f1xx_hal_gpio.o"
"uart_putty\stm32f1xx_hal_dma.o"
"uart_putty\stm32f1xx_hal_cortex.o"
"uart_putty\stm32f1xx_hal_pwr.o"
"uart_putty\stm32f1xx_hal_flash.o"
"uart_putty\stm32f1xx_hal_flash_ex.o"
"uart_putty\stm32f1xx_hal_exti.o"
"uart_putty\system_stm32f1xx.o"
--strict --scatter "uart_putty\uart_putty.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "uart_putty.map" -o uart_putty\uart_putty.axf